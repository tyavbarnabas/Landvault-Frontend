# Copy to .env.local.
#
# Unset → full mock mode: every service serves bundled demo data, no network.
# Set   → services marked "live" in src/lib/backends.ts call the backend; the
#         rest stay on demo data and say so (console, banner, dev panel).
#
# Local backend (Spring Boot) runs on port 8080 by default (its SERVER_PORT).
VITE_API_BASE_URL=

# The origins the backend accepts — mirror its CORS_ALLOWED_ORIGINS. Only used
# to warn early when this page's origin will be refused. Default:
# http://localhost:8443 (this dev server's default port).
# VITE_BACKEND_ALLOWED_ORIGINS=http://localhost:8443
